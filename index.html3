<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Continue</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      font-family: Arial, Helvetica, sans-serif;
      background: linear-gradient(135deg, #090d16 0%, #0f2922 50%, #090d16 100%);
      color: #ffffff;
    }

    .box {
      width: 100%;
      max-width: 380px;
      background: #131b2e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 36px 24px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    h1 {
      font-size: 22px;
      margin-bottom: 24px;
      color: #f1f5f9;
    }

    .btn {
      display: block;
      width: 100%;
      padding: 16px 20px;
      border-radius: 12px;
      background: linear-gradient(90deg, #10b981, #34d399);
      color: #04130d;
      font-size: 18px;
      font-weight: bold;
      text-decoration: none;
      letter-spacing: 1px;
      box-shadow: 0 0 24px rgba(16, 185, 129, 0.5);
    }

    .btn:hover {
      opacity: 0.92;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>Welcome</h1>
    <a id="goBtn" href="https://win88bdt.com/" target="_self" class="btn">CONTINUE</a>
  </div>

  <script>
    const DESTINATION_URL = "https://win88bdt.com/";
    const btn = document.getElementById("goBtn");
    btn.href = DESTINATION_URL;
  </script>
</body>
</html>
